# BookPlay Agent 系统 — 环境变量配置
# 复制为 .env 并填入你的 DeepSeek API Key

# LLM API（DeepSeek，兼容 OpenAI 格式）
# ⚠️ 请把下面的占位符替换为你的真实 DeepSeek API Key
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash

# Agent 系统配置
MAX_TOKENS=2048
AGENT_RETRY_COUNT=3
AGENT_TIMEOUT_SECONDS=120
